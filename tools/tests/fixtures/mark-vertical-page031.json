{"position":"unknown","text":"ِ"},{"position":"medial","text":"س"},{"position":"unknown","text":"َ"},{"position":"final","text":"ا"}],"id":"l15-w7-s2","pathIds":["l15-w7-p2","l15-w7-p3","l15-w7-p4","l15-w7-p5"],"text":"لْحِسَا"},{"bbox":[338.56295073581066,2456.911395025553,59.56628931761659,61.037295495302104],"characters":[{"position":"isolated","text":"ب"},{"position":"unknown","text":"ِ"}],"id":"l15-w7-s3","pathIds":["l15-w7-p6","l15-w7-p7","l15-w7-p8"],"text":"بِ"}],"text":"ٱلْحِسَابِ","transcriptMatches":true}]},"transcript":{"pageId":"page031","rawText":"\nٱلْحَجُّ أَشْهُرࣱ مَّعْلُومَٰتࣱۚ فَمَن فَرَضَ فِيهِنَّ ٱلْحَجَّ فَلَا\nرَفَثَ وَلَا فُسُوقَ وَلَا جِدَالَ فِي ٱلْحَجِّۗ وَمَا تَفْعَلُوا۟ مِنْ\nخَيْرࣲ يَعْلَمْهُ ٱللَّهُۗ وَتَزَوَّدُوا۟ فَإِنَّ خَيْرَ ٱلزَّادِ ٱلتَّقْوَىٰۖ\nوَٱتَّقُونِ يَٰٓأُو۟لِي ٱلْأَلْبَٰبِ ١٩٧ لَيْسَ عَلَيْكُمْ جُنَاحٌ\nأَن تَبْتَغُوا۟ فَضْلࣰا مِّن رَّبِّكُمْۚ فَإِذَآ أَفَضْتُم مِّنْ\nعَرَفَٰتࣲ فَٱذْكُرُوا۟ ٱللَّهَ عِندَ ٱلْمَشْعَرِ ٱلْحَرَامِۖ\nوَٱذْكُرُوهُ كَمَا هَدَىٰكُمْ وَإِن كُنتُم مِّن قَبْلِهِۦ\nلَمِنَ ٱلضَّآلِّينَ ١٩٨ ثُمَّ أَفِيضُوا۟ مِنْ حَيْثُ أَفَاضَ\nٱلنَّاسُ وَٱسْتَغْفِرُوا۟ ٱللَّهَۚ إِنَّ ٱللَّهَ غَفُورࣱ رَّحِيمࣱ ١٩٩\nفَإِذَا قَضَيْتُم مَّنَٰسِكَكُمْ فَٱذْكُرُوا۟ ٱللَّهَ كَذِكْرِكُمْ\nءَابَآءَكُمْ أَوْ أَشَدَّ ذِكْرࣰاۗ فَمِنَ ٱلنَّاسِ مَن يَقُولُ\nرَبَّنَآ ءَاتِنَا فِي ٱلدُّنْيَا وَمَا لَهُۥ فِي ٱلْأٓخِرَةِ مِنْ خَلَٰقࣲ ٢٠٠\nوَمِنْهُم مَّن يَقُولُ رَبَّنَآ ءَاتِنَا فِي ٱلدُّنْيَا حَسَنَةࣰ\nوَفِي ٱلْأٓخِرَةِ حَسَنَةࣰ وَقِنَا عَذَابَ ٱلنَّارِ ٢٠١ أُو۟لَٰٓئِكَ\nلَهُمْ نَصِيبࣱ مِّمَّا كَسَبُوا۟ۚ وَٱللَّهُ سَرِيعُ ٱلْحِسَابِ ٢٠٢\n","words":[{"characters":[{"nativeContourCount":2,"nativeLowerContourCount":0,"position":"isolated","text":"ٱ"},{"nativeContourCount":1,"nativeLowerContourCount":0,"position":"initial","text":"ل"},{"nativeContourCount":1,"nativeLowerContourCount":0,"position":"unknown","text":"ْ"},{"nativeContourCount":1,"nativeLowerContourCount":0,"position":"medial","text":"ح"},{"nativeContourCount":1,"nativeLowerContourCount":1,"position":"unknown","text":"ِ"},{"nativeContourCount":1,"nativeLowerContourCount":0,"position":"medial","text":"س"},{"nativeContourCount":1,"nativeLowerContourCount":0,"position":"unknown","text":"َ"},{"nativeContourCount":1,"nativeLowerContourCount":0,"position":"final","text":"ا"},{"nativeContourCount":2,"nativeLowerContourCount":1,"position":"isolated","text":"ب"},{"nativeContourCount":1,"nativeLowerContourCount":1,"position":"unknown","text":"ِ"}],"id":"page031:l15-w7","line":15,"ordinal":7,"text":"ٱلْحِسَابِ"}]}}
